FROM node:22.17.0-bookworm-slim AS node
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    BLENDER_BIN=/opt/blender/blender \
    PYTHONPATH=/opt/blenderworld \
    PATH=/opt/blender:/usr/local/bin:/usr/bin:/bin \
    DISABLE_AUTOUPDATER=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl xz-utils ffmpeg xvfb xauth procps \
    libx11-6 libxi6 libxfixes3 libxrender1 libxxf86vm1 libxkbcommon0 \
    libgl1 libegl1 libsm6 libice6 libdbus-1-3 libgomp1 libfontconfig1 \
    fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY install_blender.sh /opt/install_blender.sh
RUN bash /opt/install_blender.sh
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global @anthropic-ai/claude-code@2.1.220 \
    && test "$(node --version)" = "v22.17.0" \
    && test "$(claude --version)" = "2.1.220 (Claude Code)"
COPY requirements-verifier.txt /opt/requirements-verifier.txt
RUN python -m pip install --no-cache-dir -r /opt/requirements-verifier.txt
COPY blenderworld/ /opt/blenderworld/blenderworld/
COPY test.sh /tests/test.sh
COPY LICENSE /usr/local/share/licenses/BlenderWorld/LICENSE
RUN chmod 755 /tests/test.sh && mkdir -p /workspace /logs/verifier
COPY dataset/ /tests/dataset/
WORKDIR /workspace
CMD ["sleep", "infinity"]
