FROM node:22.17.0-bookworm-slim AS node
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    BLENDER_BIN=/opt/blender/blender \
    BLENDER_MCP_ADDON_PATH=/opt/bw-mcp/addon.py \
    BLENDERMCP_NO_UPDATE_CHECK=1 \
    DISABLE_AUTOUPDATER=1 \
    PATH=/opt/blender:/usr/local/bin:/usr/bin:/bin
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl xz-utils ffmpeg xvfb xauth procps \
    libx11-6 libxi6 libxfixes3 libxrender1 libxxf86vm1 libxkbcommon0 \
    libgl1 libegl1 libsm6 libice6 libdbus-1-3 libgomp1 libfontconfig1 \
    fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY install_blender.sh /opt/install_blender.sh
RUN bash /opt/install_blender.sh
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install --global @openai/codex@0.147.0 @anthropic-ai/claude-code@2.1.220 \
    && test "$(node --version)" = "v22.17.0" \
    && test "$(codex --version)" = "codex-cli 0.147.0" \
    && test "$(claude --version)" = "2.1.220 (Claude Code)"
COPY requirements-tools.txt /opt/requirements-tools.txt
RUN python -m pip install --no-cache-dir -r /opt/requirements-tools.txt
RUN python -m venv /opt/bw-mcp \
    && /opt/bw-mcp/bin/pip install --no-cache-dir mcp-for-blender==2.1.3 mcp==1.30.0 \
    && /opt/bw-mcp/bin/python -c "from importlib.resources import files; from pathlib import Path; Path('/opt/bw-mcp/addon.py').write_bytes(files('blender_mcp').joinpath('bundled/addon.py').read_bytes())"
COPY mcp_bridge.py /usr/local/bin/bw-blender-mcp
COPY blender_startup.py /usr/local/bin/blender_startup.py
COPY LICENSE /usr/local/share/licenses/BlenderWorld/LICENSE
RUN chmod 755 /usr/local/bin/bw-blender-mcp \
    && mkdir -p /workspace/exports /logs/artifacts
COPY inputs/ /workspace/inputs/
WORKDIR /workspace
CMD ["sleep", "infinity"]
